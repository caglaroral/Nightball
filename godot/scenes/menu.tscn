[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/menu.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/background.tscn" id="2_bg"]

[node name="Menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" parent="." instance=ExtResource("2_bg")]
layout_mode = 1

[node name="Content" type="CenterContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Content/Column"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "NIGHTBALL"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Content/Column"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Football with friends on the same Wi-Fi"
horizontal_alignment = 1

[node name="Gap" type="Control" parent="Content/Column"]
